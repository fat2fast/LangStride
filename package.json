{
  "name": "langstride",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @langstride/web dev",
    "build": "pnpm --filter @langstride/web build",
    "lint": "pnpm --filter @langstride/web lint",
    "test": "vitest run",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:sync": "tsx scripts/sync-content.ts",
    "local:setup": "supabase start"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
