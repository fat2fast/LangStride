# Learning Read-Model runtime source (ADR-0003, ADR-0004):
# Defaults to 'true' in development: the app reads from the local PostgreSQL read-model populated by `pnpm content:sync`.
# Set to 'false' to bypass PostgreSQL and read directly from repository Git files (offline/CI mode).
USE_DB_READ_MODEL=true
